{
  "expo": {
    "name": "contracktor",
    "slug": "contracktor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "contracktor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.contracktor.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "conTRACKtor uses the camera to capture receipt and job note photos.",
        "NSPhotoLibraryUsageDescription": "conTRACKtor uses your photo library so you can upload receipt and job note photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.contracktor.mobile",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "conTRACKtor uses the camera to capture receipt and job note photos.",
          "photosPermission": "conTRACKtor uses your photo library so you can upload receipt and job note photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8817abd-2b8b-44c1-afcf-07fed56719c9"
      }
    },
    "owner": "jpdougherty96"
  }
}
